# AEIV Sponsors — environment variables
# Copy to .env.local and fill in real values. Never commit .env files.

# --- Firebase (production project under the module owner's account) ---
# When emulators are running, the app auto-connects via VITE_USE_EMULATORS=true,
# so these values are only needed for connecting to the real project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=aeiv-sponsors.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=aeiv-sponsors
VITE_FIREBASE_STORAGE_BUCKET=aeiv-sponsors.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# --- Runtime flags ---
# true when running against the Firebase Emulator Suite (local dev)
VITE_USE_EMULATORS=true
# The tenant this deployment serves (host site tenant id). Empty = multi-tenant (tenant from route/context).
VITE_TENANT_ID=
