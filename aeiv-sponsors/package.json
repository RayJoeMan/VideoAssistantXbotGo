{
  "name": "aeiv-sponsors",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AEIV Sponsors module — multi-tenant sponsor directory, inquiry handling, and admin management. Independently deployable and integrable into AEIV platform websites.",
  "license": "UNLICENSED",
  "workspaces": [
    "functions"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "emulators": "firebase emulators:start --project demo-aeiv-sponsors",
    "emulators:export": "firebase emulators:start --project demo-aeiv-sponsors --import=./.emulator-data --export-on-exit",
    "seed": "tsx scripts/seed.ts",
    "smoke": "tsx scripts/smoke.ts",
    "deploy": "firebase deploy --project aeiv-sponsors",
    "deploy:functions": "firebase deploy --only functions --project aeiv-sponsors",
    "deploy:rules": "firebase deploy --only firestore:rules,storage --project aeiv-sponsors"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.11",
    "firebase": "^11.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "firebase-admin": "^13.0.1",
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "firebase-tools": "^13.30.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.7",
    "vitest": "^3.0.0"
  }
}
